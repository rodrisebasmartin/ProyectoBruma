[node name="RichTextLabel" type="RichTextLabel" parent="MainPanel/Margin/VBox/TabContainer/Features/Margin"]
layout_mode = 2
bbcode_enabled = true
text = "[b]Currently Functioning Systems:[/b]

• [color=cyan]Isometric 3D World[/color]: Explore Town and Wild zones.
• [color=cyan]Combat System[/color]: Dynamic targeting, Melee attacks, Blocking, and Spells.
• [color=cyan]RPG Progression[/color]: Level up, Attributes (STR/INT/DEX), and XP system.
• [color=cyan]Loot & Itemization[/color]: Randomized Affixes (Diablo-style), Rarity tiers, and Visual Pillars.
• [color=cyan]Inventory & Equipment[/color]: Full gear management and stat comparison tooltips.
• [color=cyan]NPC & AI[/color]: Interactive NPCs, Quest system, and Modular Enemy AI with threat tables.
• [color=cyan]Persistence[/color]: Multiple Save Slots and Disk-based saving (user://).
• [color=cyan]Allies[/color]: Cleric companion with healing and support AI.
• [color=cyan]Minimap[/color]: Real-time orientation with world transition markers.
• [color=cyan]Saving[/color]: Game auto-saves when changing zones (Portals)."
fit_content = true

